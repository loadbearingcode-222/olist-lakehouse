MINIO_ROOT_PASSWORD=
PLATFORM_DB_PASSWORD=
LAKEKEEPER_ENCRYPTION_KEY=
SOURCE_DB_PASSWORD=
DEBEZIUM_DB_PASSWORD=
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
